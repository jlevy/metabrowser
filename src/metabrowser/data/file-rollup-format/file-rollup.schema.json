{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jlevy/metabrowser/schemas/file-rollup.schema.json",
  "title": "File Rollup",
  "type": "object",
  "required": [
    "schema",
    "registry",
    "metrics",
    "groups",
    "no_extension",
    "remaining_types"
  ],
  "properties": {
    "schema": { "const": "file-type-breakdown-v1" },
    "registry": { "$ref": "#/$defs/registryIdentity" },
    "metrics": { "$ref": "#/$defs/populations" },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "no_extension": { "$ref": "#/$defs/noExtension" },
    "remaining_types": { "$ref": "#/$defs/remainingTypes" }
  },
  "$defs": {
    "measure": {
      "type": "object",
      "required": ["files", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "populations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/measure" }
    },
    "registryIdentity": {
      "type": "object",
      "required": ["schema_version", "revision", "fingerprint"],
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "extension": {
      "type": "object",
      "required": ["extension", "metrics"],
      "properties": {
        "extension": { "type": "string", "pattern": "^\\." },
        "metrics": { "$ref": "#/$defs/populations" }
      }
    },
    "filename": {
      "type": "object",
      "required": ["basename", "metrics"],
      "properties": {
        "basename": { "type": "string", "minLength": 1 },
        "metrics": { "$ref": "#/$defs/populations" }
      }
    },
    "others": {
      "type": "object",
      "required": ["metrics", "omitted_distinct_values"],
      "properties": {
        "metrics": { "$ref": "#/$defs/populations" },
        "omitted_distinct_values": { "type": "integer", "minimum": 1 }
      }
    },
    "family": {
      "type": "object",
      "required": ["id", "metrics", "extensions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "metrics": { "$ref": "#/$defs/populations" },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/extension" }
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["id", "families"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/family" }
        }
      }
    },
    "noExtension": {
      "type": "object",
      "required": ["metrics", "filenames", "others"],
      "properties": {
        "metrics": { "$ref": "#/$defs/populations" },
        "filenames": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/filename" }
        },
        "others": { "oneOf": [{ "$ref": "#/$defs/others" }, { "type": "null" }] }
      }
    },
    "remainingTypes": {
      "type": "object",
      "required": ["metrics", "extensions", "others"],
      "properties": {
        "metrics": { "$ref": "#/$defs/populations" },
        "extensions": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/extension" }
        },
        "others": { "oneOf": [{ "$ref": "#/$defs/others" }, { "type": "null" }] }
      }
    }
  }
}
