{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metabrowser.test/schemas/markdown-link-targets-v1.json",
  "title": "Metabrowser standard Markdown link target fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourcePath", "cases"],
  "properties": {
    "schema": { "const": "metabrowser-markdown-link-targets-v1" },
    "sourcePath": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "intent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["syntax", "authoredTarget", "action"],
            "properties": {
              "syntax": { "enum": ["markdown", "html"] },
              "authoredTarget": { "type": "string" },
              "action": { "enum": ["navigate", "embed"] },
              "label": { "type": "string" }
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "path"],
                "properties": {
                  "status": { "const": "internal" },
                  "path": { "type": "string" },
                  "query": { "type": "string" },
                  "fragment": { "type": "string" },
                  "mediaKind": { "enum": ["image", "audio", "video", "resource"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "url"],
                "properties": {
                  "status": { "const": "external" },
                  "url": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "reason"],
                "properties": {
                  "status": { "enum": ["unsafe", "unsupported"] },
                  "reason": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
