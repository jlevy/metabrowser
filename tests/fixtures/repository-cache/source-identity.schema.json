{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metabrowser.test/schemas/repository-cache-source-identity-v1.json",
  "title": "Repository cache source identity, store identity, and slug derivation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decided", "source_identity", "store_identity", "slug", "sources", "equivalence", "slug_collisions", "provider_stores"],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "store_key"],
      "properties": { "store_id": { "$ref": "#/$defs/digest" }, "store_key": { "$ref": "#/$defs/key" } }
    }
  },
  "properties": {
    "schema": { "const": "metabrowser-repository-cache-source-identity-v1" },
    "decided": { "type": "string", "format": "date" },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "material", "encoding", "rules"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "material": { "type": "string" },
        "encoding": { "type": "string" },
        "rules": { "$ref": "#/$defs/rules" }
      }
    },
    "store_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "generic_material", "provider_material", "encoding", "key_hex_digits", "rules"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "generic_material": { "type": "string" },
        "provider_material": { "type": "string" },
        "encoding": { "type": "string" },
        "key_hex_digits": { "const": 64 },
        "rules": { "$ref": "#/$defs/rules" }
      }
    },
    "slug": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_separator", "readable_max_bytes", "empty_readable", "suffix_hex_digits", "max_bytes", "rules"],
      "properties": {
        "token_separator": { "const": "--" },
        "readable_max_bytes": { "type": "integer", "minimum": 1, "maximum": 189 },
        "empty_readable": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "suffix_hex_digits": { "type": "array", "items": { "type": "integer", "minimum": 12, "maximum": 64 }, "uniqueItems": true },
        "max_bytes": { "type": "integer", "maximum": 255 },
        "rules": { "$ref": "#/$defs/rules" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "transport", "form", "normalized", "source_id", "slug", "generic_stores"],
        "properties": {
          "input": { "type": "string" },
          "transport": { "enum": ["https", "ssh", "file"] },
          "form": { "enum": ["url", "scp"] },
          "normalized": { "type": "string" },
          "source_id": { "$ref": "#/$defs/digest" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+--[0-9a-f]{12,64}$" },
          "generic_stores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha1", "sha256"],
            "properties": { "sha1": { "$ref": "#/$defs/store" }, "sha256": { "$ref": "#/$defs/store" } }
          }
        }
      }
    },
    "equivalence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputs", "same_source", "why"],
        "properties": {
          "inputs": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "same_source": { "type": "boolean" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "slug_collisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["normalized", "existing", "expected_slug", "why"],
        "properties": {
          "normalized": { "type": "string" },
          "existing": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
          "expected_slug": { "type": "string" },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provider_stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_kind", "provider_instance", "repository_opaque_id", "object_format", "store_id", "store_key"],
        "properties": {
          "provider_kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "provider_instance": { "type": "string", "minLength": 1 },
          "repository_opaque_id": { "type": "string", "minLength": 1 },
          "object_format": { "enum": ["sha1", "sha256"] },
          "store_id": { "$ref": "#/$defs/digest" },
          "store_key": { "$ref": "#/$defs/key" }
        }
      }
    }
  }
}
