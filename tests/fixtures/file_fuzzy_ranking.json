{
  "normalization": {
    "candidatePaths": "Served-root-relative paths with forward slashes",
    "case": "JavaScript String.prototype.toLowerCase without locale-specific or diacritic folding",
    "query": "Trim surrounding whitespace; preserve internal punctuation and slashes"
  },
  "comparisonOrder": [
    "matchClass ascending",
    "boundaryHits descending",
    "contiguousChars descending",
    "runCount ascending",
    "gapChars ascending",
    "startOffset ascending",
    "candidateLength ascending",
    "directoryDepth ascending",
    "normalizedPath by UTF-16 code unit",
    "originalPath by UTF-16 code unit"
  ],
  "scenarios": [
    {
      "id": "exact-basename",
      "query": "app.js",
      "candidates": ["src/application.js", "src/app.js", "examples/app.jsx"],
      "expected": ["src/app.js", "examples/app.jsx", "src/application.js"],
      "rationale": "An exact basename outranks a longer basename prefix and an ordered-subsequence match.",
      "tags": ["exact"]
    },
    {
      "id": "basename-prefix-length",
      "query": "app",
      "candidates": ["src/application.js", "src/app.js", "src/happy.js"],
      "expected": ["src/app.js", "src/application.js", "src/happy.js"],
      "rationale": "Basename prefixes precede other contiguous basename matches; the shorter prefix wins a tie.",
      "tags": ["prefix", "length"]
    },
    {
      "id": "basename-before-parent",
      "query": "app",
      "candidates": ["app/config.js", "src/app.js", "examples/happy.js"],
      "expected": ["src/app.js", "examples/happy.js", "app/config.js"],
      "rationale": "Any basename match is more useful for file navigation than a match found only in a parent directory.",
      "tags": ["basename-vs-parent"]
    },
    {
      "id": "separator-boundaries",
      "query": "fb",
      "candidates": ["src/foobar.js", "src/final-bundle.js", "src/foo-bar.js"],
      "expected": ["src/foo-bar.js", "src/final-bundle.js", "src/foobar.js"],
      "rationale": "Dash boundaries beat an interior character, and the boundary match with the smaller gap wins.",
      "tags": ["boundary", "punctuation", "gaps"]
    },
    {
      "id": "camel-case-boundary",
      "query": "fb",
      "candidates": ["src/foobar.js", "src/FooBar.js"],
      "expected": ["src/FooBar.js", "src/foobar.js"],
      "rationale": "A transition from a lowercase character to an uppercase character is a word boundary.",
      "tags": ["boundary", "case"]
    },
    {
      "id": "separator-boundary",
      "query": "at",
      "candidates": ["src/afterthought.js", "src/after-thought.js"],
      "expected": ["src/after-thought.js", "src/afterthought.js"],
      "rationale": "A dash starts a word and therefore improves an otherwise equivalent subsequence.",
      "tags": ["boundary", "punctuation"]
    },
    {
      "id": "contiguous-before-gapped",
      "query": "cfg",
      "candidates": ["src/configuration.js", "src/abcfg.js"],
      "expected": ["src/abcfg.js", "src/configuration.js"],
      "rationale": "A contiguous basename occurrence outranks a gapped basename subsequence.",
      "tags": ["contiguous", "gaps"]
    },
    {
      "id": "path-query",
      "query": "src/app",
      "candidates": ["src/lib/application.js", "source/app.js", "src/app.js"],
      "expected": ["src/app.js", "source/app.js", "src/lib/application.js"],
      "rationale": "Slash queries match the relative path directly; contiguous paths and smaller gaps rank first.",
      "tags": ["path", "gaps"]
    },
    {
      "id": "path-without-slash-fallback",
      "query": "srcapp",
      "candidates": ["src/metabrowser/static/app.js", "source/application.js"],
      "expected": ["src/metabrowser/static/app.js", "source/application.js"],
      "rationale": "A query without a slash may fall back to the full path when no basename can match it.",
      "tags": ["path", "fallback"]
    },
    {
      "id": "repeated-characters",
      "query": "rdr",
      "candidates": ["src/renderer.js", "src/reader.js", "src/render.js"],
      "expected": ["src/reader.js", "src/render.js", "src/renderer.js"],
      "rationale": "Repeated query characters consume distinct candidate positions; shorter equal-gap matches win before stable path ties.",
      "tags": ["repeated", "length"]
    },
    {
      "id": "case-insensitive-prefix",
      "query": "readme",
      "candidates": ["docs/Readme.mdx", "README.md", "docs/read-me.md"],
      "expected": ["README.md", "docs/Readme.mdx", "docs/read-me.md"],
      "rationale": "Case does not affect eligibility; basename prefixes rank before a separator-assisted subsequence.",
      "tags": ["case", "prefix"]
    },
    {
      "id": "unicode-code-points",
      "query": "üb",
      "candidates": ["docs/uber.md", "docs/Überblick.md", "docs/über.md"],
      "expected": ["docs/über.md", "docs/Überblick.md"],
      "rationale": "Unicode characters participate in ordinary case-insensitive matching without accent folding.",
      "tags": ["unicode", "case"]
    },
    {
      "id": "original-path-total-order",
      "query": "ab",
      "candidates": ["src/a-b.js", "src/A-B.js"],
      "expected": ["src/A-B.js", "src/a-b.js"],
      "rationale": "When every semantic component and normalized path ties, original UTF-16 code-unit order is final.",
      "tags": ["tie", "case", "boundary"]
    },
    {
      "id": "no-match",
      "query": "xyz",
      "candidates": ["README.md", "src/app.js"],
      "expected": [],
      "rationale": "Every query character must appear in order; partial character coverage is not eligible.",
      "tags": ["no-match"]
    }
  ]
}
