    {
      "id": "exact-vault-path-precedes-suffix",
      "intent": { "authoredTarget": "Folder/Guide", "action": "navigate" },
      "expected": { "status": "internal", "path": "Folder/Guide.md" }
    },
    {
      "id": "unique-path-suffix",
      "intent": { "authoredTarget": "Nested/Unique", "action": "navigate" },
